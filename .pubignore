# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.buildlog/
.history
.svn/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
# Libraries should not include pubspec.lock, per https://dart.dev/guides/libraries/private-files#pubspeclock.
/pubspec.lock
**/doc/api/
.dart_tool/
build/
.claude/settings.local.json

# --- pub only (when .pubignore exists, .gitignore is not used here) ---
# GIFs used by the README are loaded from GitHub; ship only the screenshot
# referenced in pubspec.yaml to keep the package download small.
screenshots/*
!screenshots/christmas_mix.gif
.claude/
